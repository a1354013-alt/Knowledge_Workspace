# Backend environment
# JWT_SECRET must be at least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-characters-required
DEFAULT_OWNER_PASSWORD=ChangeMe123!
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_PATH=documents.db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
PHOTO_DIR=./photos
CHROMA_DB_PATH=./chroma_db
AUTOTEST_DIR=./autotest_uploads
AUTOTEST_MODE=simulated
# Real mode remains disabled unless this is explicitly set to 1.
KNOWLEDGE_WORKSPACE_ENABLE_REAL_AUTOTEST=0
AUTOTEST_TIMEOUT_SECONDS=120
AUTOTEST_MAX_FILES=500
AUTOTEST_MAX_UNZIPPED_BYTES=52428800
AUTOTEST_RLIMIT_CPU_SECONDS=30
AUTOTEST_RLIMIT_AS_MB=512
AUTOTEST_RLIMIT_FSIZE_MB=64
AUTOTEST_STALE_RUN_MINUTES=30
OCR_ENABLED=true
# OCR requires a system Tesseract binary. If it is not on PATH, set:
# OCR_TESSERACT_CMD=/absolute/path/to/tesseract
# LLM Configuration (optional, defaults to Ollama at localhost:11434).
# OpenAI is not enabled in this release; add provider implementation, tests, and docs before adding OPENAI_API_KEY.
# LLM_PROVIDER=ollama  # Options: ollama, mock, fallback
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
