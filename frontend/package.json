{
  "name": "knowledge-workspace-frontend",
  "version": "5.0.0",
  "description": "Knowledge Workspace frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=line",
    "test:watch": "vitest",
    "lint": "eslint src tests e2e eslint.config.js vite.config.ts playwright.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "generate:api-types": "python ../scripts/generate_api_types.py",
    "check:api-types": "python ../scripts/generate_api_types.py --check"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "axios": "^1.16.0",
    "primeicons": "^6.0.0",
    "primevue": "^4.0.0",
    "vue": "^3.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@eslint/js": "9.33.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "25.6.0",
    "@typescript-eslint/eslint-plugin": "8.46.1",
    "@typescript-eslint/parser": "8.46.1",
    "@vitejs/plugin-vue": "6.0.6",
    "@vue/test-utils": "^2.4.6",
    "eslint": "9.33.0",
    "eslint-plugin-vue": "10.5.1",
    "globals": "^16.4.0",
    "happy-dom": "^20.9.0",
    "typescript": "5.9.3",
    "vite": "8.0.12",
    "vitest": "4.1.6",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.2.7"
  }
}
