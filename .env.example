# Backend runtime
# Copy this file to backend/.env when starting the API from backend/.
# Paths below are therefore backend-relative to avoid accidental backend/backend/... nesting.
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-characters
DEFAULT_OWNER_PASSWORD=replace-with-a-local-password
DATABASE_PATH=./documents.db
UPLOAD_DIR=./uploads
PHOTO_DIR=./photos
CHROMA_DB_PATH=./chroma_db

# AutoTest terminology:
# - AUTOTEST_MODE=simulated keeps the runner disabled and never executes uploaded code.
# - "live execution" in docs means execution_mode=real via AUTOTEST_MODE=real or AUTOTEST_MODE=docker_sandbox.
# - AUTOTEST_SANDBOX_BACKEND=local_trusted is only for trusted local projects.
AUTOTEST_MODE=simulated
KW_AUTOTEST_REAL_MODE=0
KNOWLEDGE_WORKSPACE_ENABLE_REAL_AUTOTEST=0
AUTOTEST_SANDBOX_BACKEND=disabled
AUTOTEST_STALE_RUN_MINUTES=30
AUTOTEST_DOCKER_IMAGE=python:3.11-slim
AUTOTEST_DOCKER_NETWORK=false
AUTOTEST_DOCKER_MEMORY=2g
AUTOTEST_DOCKER_CPUS=2

# Embedding provider: demo_hash or ollama. Ollama gracefully falls back when enabled below.
EMBEDDING_PROVIDER=demo_hash
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT_SECONDS=5
EMBEDDING_FALLBACK_ENABLED=true

# LLM provider
# OpenAI is not enabled in this release. Keep LLM_PROVIDER=ollama unless a provider
# implementation, tests, and API documentation are added together.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
